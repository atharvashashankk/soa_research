{
  "name": "agent-memory-atlas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Evidence-linked research on memory in software development agents",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "collect": "node scripts/collect.mjs",
    "discover": "node scripts/collect.mjs --discover",
    "analyze": "node scripts/analyze.mjs",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/serve.mjs",
    "test": "node --test tests/pipeline.test.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "check": "npm run test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "cheerio": "^1.2.0",
    "fast-xml-parser": "^5.11.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "agent-browser": "^0.27.0",
    "playwright": "^1.63.0"
  }
}
